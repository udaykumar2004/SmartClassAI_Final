@model SmartClassAI.WebApp.Services.TeacherStatsDto
@{
    ViewData["Title"] = "Teacher Hub";
    ViewData["PageSubtitle"] = "Overview of your teaching activity";
}

<partial name="_PageHeader" />

<div class="stat-grid">
    <div class="stat-card">
        <i class="fa-solid fa-chalkboard icon"></i>
        <div class="label">Classrooms</div>
        <div class="value">@Model.TotalClassrooms</div>
    </div>
    <div class="stat-card">
        <i class="fa-solid fa-user-group icon"></i>
        <div class="label">Students</div>
        <div class="value">@Model.TotalStudents</div>
    </div>
    <div class="stat-card">
        <i class="fa-solid fa-file-pen icon"></i>
        <motion class="label">Assignments</motion>
        <div class="value">@Model.TotalAssignments</div>
    </div>
    <div class="stat-card">
        <i class="fa-solid fa-clock icon"></i>
        <div class="label">Pending reviews</div>
        <div class="value text-warning">@Model.PendingSubmissions</div>
    </div>
</div>

<div class="glass-card p-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <div>
        <h5 class="fw-bold mb-1">Quick actions</h5>
        <p class="text-muted small mb-0">Manage classes and review student work</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Classroom" asp-action="Index" class="btn btn-sc-primary">My classes</a>
        <a asp-controller="Classroom" asp-action="Upsert" class="btn btn-sc-outline">Create class</a>
    </div>
</div>
