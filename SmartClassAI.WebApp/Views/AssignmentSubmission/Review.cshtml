@model SmartClassAI.Models.AssignmentSubmission

<div class="container mt-5">

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-body p-5">

            <h2 class="fw-bold mb-4">

                Review Submission

            </h2>

            <!-- STUDENT INFO -->

            <div class="mb-4">

                <h5 class="fw-bold">

                    Student

                </h5>

                <p class="text-muted">

                    @Model.Student?.FullName

                </p>

            </div>

            <!-- SUBMISSION -->

            <div class="mb-4">

                <h5 class="fw-bold">

                    Submission Text

                </h5>

                <p>

                    @Model.SubmissionText

                </p>

            </div>

            <!-- FILE -->
            @if (!string.IsNullOrEmpty(
                        Model.SubmissionFileUrl))
            {
                <div class="mb-4">

                    <a href="@Model.SubmissionFileUrl"
                       target="_blank"
                       class="btn btn-dark rounded-pill">

                        View Submitted File

                    </a>

                </div>
            }

            <!-- FORM -->

            <form method="post">

                <input asp-for="Id" hidden />

                <!-- MARKS -->

                <div class="mb-4">

                    <label asp-for="Marks"
                           class="form-label fw-semibold">

                    </label>

                    <input asp-for="Marks"
                           class="form-control" />

                </div>

                <!-- FEEDBACK -->

                <div class="mb-4">

                    <label asp-for="Feedback"
                           class="form-label fw-semibold">

                    </label>

                    <textarea asp-for="Feedback"
                              rows="5"
                              class="form-control"></textarea>

                </div>

                <!-- BUTTONS -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success rounded-pill px-4">

                        Save Review

                    </button>

                    <a asp-action="Index"
                       asp-route-assignmentId="@Model.AssignmentId"
                       class="btn btn-secondary rounded-pill px-4">

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>