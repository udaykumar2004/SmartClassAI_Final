@model SmartClassAI.Models.AssignmentSubmission

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- CARD -->
            <div class="card border-0 shadow-lg rounded-5 overflow-hidden">

                <!-- HEADER -->
                <div class="p-5 text-white position-relative"
                     style="background: linear-gradient(135deg, #6366f1, #06b6d4);">

                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h2 class="fw-bold mb-1">📤 Submit Assignment</h2>
                            <p class="mb-0 opacity-75">
                                Upload your work & track evaluation status in real time
                            </p>
                        </div>
                    </div>

                    <!-- decorative blur circles -->
                    <div style="position:absolute; top:-40px; right:-40px; width:120px; height:120px; background:rgba(255,255,255,0.15); border-radius:50%;"></div>
                    <div style="position:absolute; bottom:-50px; left:30px; width:140px; height:140px; background:rgba(255,255,255,0.10); border-radius:50%;"></div>

                </div>

                <div class="card-body p-5">

                    <!-- STATUS CARD -->
                    @if (Model.Id > 0)
                    {
                        <div class="p-4 rounded-4 mb-4 border shadow-sm"
                             style="background:#f8fafc;">

                            @if (Model.Marks != null)
                            {
                                <div class="d-flex align-items-center justify-content-between">

                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center"
                                             style="width:45px;height:45px;">
                                            ✓
                                        </div>

                                        <div>
                                            <h5 class="mb-0 text-success fw-bold">Evaluated</h5>
                                            <small class="text-muted">Your submission has been checked</small>
                                        </div>
                                    </div>

                                    <div>
                                        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">
                                            ⭐ Marks: @Model.Marks
                                        </span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Feedback))
                                {
                                    <div class="mt-3 p-3 rounded-3 border bg-white">
                                        <strong>🧑‍🏫 Feedback:</strong>
                                        <div class="text-muted mt-1">@Model.Feedback</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-between">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center"
                                             style="width:45px;height:45px;">
                                            ⏳
                                        </div>

                                        <div>
                                            <h5 class="mb-0 fw-bold text-warning">Pending Evaluation</h5>
                                            <small class="text-muted">Submitted successfully</small>
                                        </div>

                                    </div>

                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                        Not Graded
                                    </span>

                                </div>
                            }

                        </div>
                    }

                    <!-- FORM -->
                    <form method="post" enctype="multipart/form-data">

                        <input asp-for="AssignmentId" hidden />

                        <!-- TEXTAREA -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">📝 Submission Notes</label>

                            <textarea asp-for="SubmissionText"
                                      rows="5"
                                      class="form-control border-0 shadow-sm p-3 rounded-4"
                                      placeholder="Write your submission details..."></textarea>
                        </div>

                        <!-- FILE UPLOAD -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">📎 Upload File</label>

                            <div class="border border-dashed rounded-4 p-4 text-center bg-light">

                                <input type="file"
                                       name="file"
                                       class="form-control d-inline-block w-auto"
                                       accept=".pdf,.doc,.docx,.zip,.png,.jpg,.jpeg" />

                                <div class="text-muted mt-2 small">
                                    Supported formats: PDF, DOCX, ZIP, Images
                                </div>

                            </div>
                        </div>

                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-between mt-4">

                            <a asp-controller="Assignment"
                               asp-action="Details"
                               asp-route-id="@Model.AssignmentId"
                               class="btn btn-light border rounded-pill px-4 shadow-sm">
                                ← Back
                            </a>

                            <button type="submit"
                                    class="btn btn-primary rounded-pill px-5 shadow-lg"
                                    style="background:linear-gradient(135deg,#6366f1,#06b6d4); border:none;">
                                🚀 Submit Now
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>