@{
    ViewData["Title"] = "Admin Dashboard";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet">


<style>
    * {
        font-family: 'Poppins', sans-serif;
    }

    body {
        background: #0f172a;
        overflow-x: hidden;
    }

    .bg-blur-1, .bg-blur-2 {
        position: fixed;
        border-radius: 50%;
        filter: blur(120px);
        z-index: -1;
    }

    .bg-blur-1 {
        width: 350px;
        height: 350px;
        background: #7c3aed;
        top: -100px;
        left: -100px;
        opacity: 0.35;
    }

    .bg-blur-2 {
        width: 400px;
        height: 400px;
        background: #2563eb;
        bottom: -120px;
        right: -100px;
        opacity: 0.35;
    }

    .admin-wrapper {
        padding: 30px;
    }

    /* HERO */
    .hero-card {
        position: relative;
        border-radius: 30px;
        padding: 40px;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.12);
        box-shadow: 0 20px 60px rgba(0,0,0,0.35);
        margin-bottom: 25px;
    }

    .hero-title {
        font-size: 42px;
        font-weight: 700;
        color: white;
    }

    .hero-subtitle {
        color: rgba(255,255,255,0.75);
    }

    /* LIVE STATUS */
    .connection-status {
        position: fixed;
        top: 85px;
        right: 25px;
        padding: 10px 18px;
        border-radius: 14px;
        font-size: 13px;
        color: white;
        background: rgba(34,197,94,0.18);
        border: 1px solid rgba(34,197,94,0.45);
        backdrop-filter: blur(12px);
        z-index: 999;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.25);
        transition: 0.3s ease;
    }

        .connection-status:hover {
            transform: translateY(-2px);
        }

    .online-dot {
        width: 10px;
        height: 10px;
        background: #22c55e;
        border-radius: 50%;
        display: inline-block;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.4);
            opacity: 0.6;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* STATS */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 25px;
        margin-bottom: 35px;
    }

    .stat-card {
        padding: 28px;
        border-radius: 28px;
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.1);
        transition: 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-6px);
        }

    .stat-title {
        color: rgba(255,255,255,0.7);
    }

    .stat-value {
        color: white;
        font-size: 38px;
        font-weight: 700;
    }

    .section-title {
        color: white;
        font-size: 24px;
        margin-bottom: 15px;
    }

    /* ACTIVITY */
    .activity-box {
        background: rgba(255,255,255,0.08);
        padding: 25px;
        border-radius: 25px;
        border: 1px solid rgba(255,255,255,0.1);
        max-height: 400px;
        overflow-y: auto;
    }

    .activity-item {
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 12px;
        background: rgba(255,255,255,0.05);
        transition: 0.3s;
    }

        .activity-item:hover {
            background: rgba(255,255,255,0.1);
        }

    .activity-text {
        color: white;
        font-size: 14px;
    }

    .activity-time {
        color: gray;
        font-size: 11px;
    }

    /* RESPONSIVE */
    @@media(max-width:768px) {

        .hero-title {
            font-size: 30px;
        }

        .connection-status {
            top: 75px;
            right: 15px;
            padding: 8px 14px;
            font-size: 12px;
        }

        .admin-wrapper {
            padding: 18px;
        }
    }
</style>

<div class="bg-blur-1"></div>
<div class="bg-blur-2"></div>

<div class="connection-status">
    <span class="online-dot"></span>
    Live Connected
</div>

<div class="admin-wrapper">

    <!-- HERO -->
    <div class="hero-card">
        <div class="hero-title">Admin Dashboard 👑</div>
        <div class="hero-subtitle">Real-time SmartClass AI Monitoring System</div>
    </div>

    <!-- STATS -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-title">Total Users</div>
            <div class="stat-value totalUsers">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Teachers</div>
            <div class="stat-value teachers">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Students</div>
            <div class="stat-value students">0</div>
        </div>

        <div class="stat-card">
            <div class="stat-title">Classrooms</div>
            <div class="stat-value classrooms">0</div>
        </div>

    </div>

    <!-- ACTIVITY -->
    <div class="section-title">Recent Activity</div>
    <div class="activity-box"></div>

</div>

<!-- SIGNALR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/adminHub")
        .withAutomaticReconnect()
        .build();

    async function start() {
        try {
            await connection.start();
            console.log("SignalR Connected");
        } catch (err) {
            setTimeout(start, 3000);
        }
    }

    connection.onclose(start);
    start();


    // 📊 LIVE STATS
    function applyStats(data) {
        animate(".totalUsers", data.totalUsers);
        animate(".teachers", data.totalTeachers);
        animate(".students", data.totalStudents);
        animate(".classrooms", data.totalClassrooms);
    }

    fetch('@Url.Action("GetStats", "Admin")')
        .then(r => r.json())
        .then(applyStats);

    connection.on("ReceiveDashboardUpdate", applyStats);


    // 📢 LIVE ACTIVITY
    connection.on("ReceiveActivity", function (message) {

        let box = document.querySelector(".activity-box");

        let item = document.createElement("div");
        item.className = "activity-item";

        item.innerHTML = `
            <div class="activity-text">📢 ${message}</div>
            <div class="activity-time">just now</div>
        `;

        box.prepend(item);
    });


    // ✨ NUMBER ANIMATION
    function animate(selector, value) {

        let el = document.querySelector(selector);

        let current = parseInt(el.innerText) || 0;

        let step = Math.ceil((value - current) / 20);

        let interval = setInterval(() => {

            current += step;

            if ((step > 0 && current >= value) || (step < 0 && current <= value)) {
                current = value;
                clearInterval(interval);
            }

            el.innerText = current;

        }, 30);
    }
</script>