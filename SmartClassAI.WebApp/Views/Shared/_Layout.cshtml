@using Microsoft.AspNetCore.Identity
@using SmartClassAI.Models
@using SmartClassAI.WebApp.Utility
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    bool isLoggedIn = SignInManager.IsSignedIn(User);
    ApplicationUser? user = isLoggedIn ? await UserManager.GetUserAsync(User) : null;

    bool isAdmin = user != null && await UserManager.IsInRoleAsync(user, SD.Role_Admin);
    bool isTeacher = user != null && await UserManager.IsInRoleAsync(user, SD.Role_Teacher);
    bool isStudent = user != null && await UserManager.IsInRoleAsync(user, SD.Role_Student);

    string userEmail = user?.Email ?? "Guest";
    string displayName = !string.IsNullOrWhiteSpace(user?.FullName) ? user!.FullName : userEmail;
    string initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "G";

    var pageTitle = ViewData["Title"]?.ToString() ?? "SmartClass AI";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle · SmartClass AI</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/smartclass.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <!-- SIDEBAR -->
    <aside id="appSidebar" class="app-sidebar">

        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <span class="sidebar-brand-text">SmartClass AI</span>
        </div>

        <nav class="sidebar-nav">

            <a asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-house"></i><span>Home</span>
            </a>

            @if (isLoggedIn)
            {
                <span class="sidebar-section">Learning</span>

                <a asp-controller="Classroom" asp-action="Index">
                    <i class="fa-solid fa-book-open"></i><span>My Classes</span>
                </a>

                <a asp-controller="Classroom" asp-action="Join">
                    <i class="fa-solid fa-link"></i><span>Join Class</span>
                </a>

                @if (isTeacher || isAdmin)
                {
                    <a asp-controller="Classroom" asp-action="Upsert">
                        <i class="fa-solid fa-plus"></i><span>Create Class</span>
                    </a>

                    <a asp-controller="Dashboard" asp-action="Teacher">
                        <i class="fa-solid fa-chart-pie"></i><span>Teacher Hub</span>
                    </a>
                }

                @if (isStudent)
                {
                    <a asp-controller="Dashboard" asp-action="Student">
                        <i class="fa-solid fa-user-graduate"></i><span>Student Hub</span>
                    </a>
                }

                <span class="sidebar-section">Account</span>

                <a asp-controller="Profile" asp-action="Index">
                    <i class="fa-solid fa-user"></i><span>Profile</span>
                </a>
            }

            @if (isAdmin)
            {
                <span class="sidebar-section">Admin</span>

                <a asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-gauge-high"></i><span>Dashboard</span>
                </a>

                <a asp-controller="Admin" asp-action="Users">
                    <i class="fa-solid fa-users"></i><span>Users</span>
                </a>

                <a asp-controller="Admin" asp-action="Classrooms">
                    <i class="fa-solid fa-school"></i><span>Classrooms</span>
                </a>

                <a asp-controller="Admin" asp-action="AuditLogs">
                    <i class="fa-solid fa-clipboard-list"></i><span>Audit Logs</span>
                </a>
            }

            @if (!isLoggedIn)
            {
                <span class="sidebar-section">Welcome</span>

                <a asp-area="Identity" asp-page="/Account/Login">
                    <i class="fa-solid fa-right-to-bracket"></i><span>Login</span>
                </a>

                <a asp-area="Identity" asp-page="/Account/Register">
                    <i class="fa-solid fa-user-plus"></i><span>Register</span>
                </a>
            }

        </nav>
    </aside>

    <!-- MAIN -->
    <div class="app-main">

        <!-- TOPBAR -->
        <header class="app-topbar">

            <div class="d-flex align-items-center gap-3">
                <button type="button" id="sidebarToggle" class="btn-icon sidebar-toggle">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <h1 class="topbar-title d-none d-md-block">
                    @pageTitle
                </h1>

                @if (IsSectionDefined("PageActions"))
                {
                    <div class="page-actions">
                        @RenderSection("PageActions", required: false)
                    </div>
                }
            </div>

            <div class="topbar-actions">

                <button type="button" id="themeToggle" class="btn-icon">
                    <i class="fa-solid fa-moon"></i>
                </button>

                @if (isLoggedIn)
                {
                    <a asp-controller="Profile" asp-action="Index" class="user-chip d-none d-sm-flex">

                        <div class="user-avatar">
                            @if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
                            {
                                <img src="@user.ProfilePictureUrl" alt="profile" />
                            }
                            else
                            {
                                @initial
                            }
                        </div>

                        <div class="text-start lh-sm">
                            <div class="fw-bold small">@displayName</div>
                            <div class="text-muted" style="font-size:0.7rem">@userEmail</div>
                        </div>

                    </a>

                    <form id="logoutForm"
                          method="post"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home")">

                        @Html.AntiForgeryToken()

                        <button type="button" id="logoutBtn"
                                class="btn btn-sm btn-outline-danger rounded-3">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm"
                       asp-area="Identity"
                       asp-page="/Account/Login">Login</a>

                    <a class="btn btn-outline-secondary btn-sm"
                       asp-area="Identity"
                       asp-page="/Account/Register">Sign up</a>
                }

            </div>

        </header>

        <!-- CONTENT -->
        <main class="app-content">
            @RenderBody()
        </main>

    </div>

    <partial name="_Notifications" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/smartclass.js" asp-append-version="true"></script>

    <script>
        document.getElementById('logoutBtn')?.addEventListener('click', function () {
            document.getElementById('logoutForm').submit();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>