@model SmartClassAI.Models.Assignment
@using System.Security.Claims

@{
    ViewData["Title"] = "Assignment Details";

    var currentUserId =
        User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

    var submission = Model.Submissions?
        .FirstOrDefault(x => x.StudentId == currentUserId);

    bool isSubmitted = submission != null;
    bool canResubmit = isSubmitted && Model.DueDate > DateTime.Now;
    bool isClosed = Model.DueDate <= DateTime.Now;
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #0f172a, #111827);
        color: white;
    }

    .glass {
        background: rgba(255,255,255,0.06);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 8px 30px rgba(0,0,0,0.3);
    }

    .card-hover {
        transition: 0.3s ease;
    }

    .card-hover:hover {
        transform: translateY(-6px);
        background: rgba(255,255,255,0.09);
    }

    .title {
        font-size: 38px;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .badge-soft {
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-modern {
        border-radius: 50px;
        padding: 10px 22px;
        font-weight: 600;
        transition: 0.25s;
    }

    .btn-modern:hover {
        transform: scale(1.05);
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    .section-title {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 10px;
    }

</style>

<div class="container py-5">

    <!-- ================= HEADER ================= -->
    <div class="glass card-hover rounded-4 p-4 mb-4">

        <div class="d-flex justify-content-between flex-wrap">

            <div>
                <h1 class="title">@Model.Title</h1>
                <p class="text-white-50">
                    Posted: @Model.CreatedAt.ToShortDateString()
                </p>
            </div>

            <div>
                <span class="badge bg-danger badge-soft">
                    Due: @Model.DueDate.ToShortDateString()
                </span>
            </div>

        </div>

        <hr class="border-light opacity-25"/>

        <h5 class="section-title">Description</h5>
        <p class="text-white-75">@Model.Description</p>

        @if (!string.IsNullOrEmpty(Model.FileUrl))
        {
            <a href="@Model.FileUrl"
               target="_blank"
               class="btn btn-dark btn-modern mt-2">
                View Attachment
            </a>
        }

        <div class="mt-3 d-flex gap-2 flex-wrap">

            <span class="badge bg-primary badge-soft">
                @Model.Status
            </span>

            <span class="badge bg-info text-dark badge-soft">
                Marks: @Model.TotalMarks
            </span>

        </div>

    </div>

    <!-- ================= SUBMISSION STATUS ================= -->
    

    <!-- ================= ACTION BUTTONS ================= -->
    <div class="glass card-hover rounded-4 p-4 mb-4">

        <h5 class="section-title">Actions</h5>

        <div class="d-flex gap-3 flex-wrap">

            @if (!isClosed)
            {
                @if (!isSubmitted)
                {
                    <a asp-controller="AssignmentSubmission"
                       asp-action="Submit"
                       asp-route-assignmentId="@Model.Id"
                       class="btn btn-success btn-modern">
                        Submit Work
                    </a>
                }
                else if (canResubmit)
                {
                    <a asp-controller="AssignmentSubmission"
                       asp-action="Submit"
                       asp-route-assignmentId="@Model.Id"
                       class="btn btn-warning btn-modern">
                        ReSubmit Work
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary btn-modern" disabled>
                        Locked
                    </button>
                }
            }
            else
            {
                <button class="btn btn-dark btn-modern" disabled>
                    Deadline Passed
                </button>
            }

        </div>

    </div>

    <!-- ================= COMMENTS ================= -->
    <div class="glass card-hover rounded-4 p-4">

        <h5 class="section-title">Comments</h5>

        @if (Model.Comments != null && Model.Comments.Any())
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="border border-light border-opacity-10 rounded-4 p-3 mb-3">

                    <div class="d-flex justify-content-between">
                        <strong>@comment.UserName</strong>
                        <small class="text-white-50">
                            @comment.CreatedAt.ToShortDateString()
                        </small>
                    </div>

                    <p class="mb-0 mt-2 text-white-75">
                        @comment.Message
                    </p>

                </div>
            }
        }
        else
        {
            <p class="text-white-50">No comments yet.</p>
        }

    </div>

</div>