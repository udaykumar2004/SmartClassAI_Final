@model SmartClassAI.Models.Classroom

<div class="container mt-4">

    <div class="card shadow-lg border-0 rounded-4">

        <!-- HEADER -->
        <div class="card-header bg-primary text-white py-3 rounded-top-4">

            <div class="d-flex justify-content-between align-items-center">

                <h3 class="mb-0">
                    <i class="fa fa-chalkboard me-2"></i>

                    @(Model.Id == 0
                                        ? "Create Classroom"
                                        : "Update Classroom")
                </h3>

            </div>

        </div>

        <!-- BODY -->
        <div class="card-body p-4">

            <form method="post">

                <input asp-for="Id" hidden />

                <!-- CLASS NAME -->
                <div class="mb-4">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Name"
                           class="form-control form-control-lg"
                           placeholder="Enter classroom name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <!-- SECTION -->
                <div class="mb-4">

                    <label asp-for="Section"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Section"
                           class="form-control form-control-lg"
                           placeholder="Enter section" />

                    <span asp-validation-for="Section"
                          class="text-danger">
                    </span>

                </div>

                <!-- SUBJECT -->
                <div class="mb-4">

                    <label asp-for="Subject"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Subject"
                           class="form-control form-control-lg"
                           placeholder="Enter subject" />

                    <span asp-validation-for="Subject"
                          class="text-danger">
                    </span>

                </div>

                <!-- BUTTONS -->
                <div class="d-flex gap-2">

                    @if (Model.Id == 0)
                    {
                        <button type="submit"
                                class="btn btn-success px-4">

                            <i class="fa fa-plus me-1"></i>
                            Create

                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="btn btn-primary px-4">

                            <i class="fa fa-pen me-1"></i>
                            Update

                        </button>
                    }

                    <a asp-action="Index"
                       class="btn btn-secondary px-4">

                        <i class="fa fa-arrow-left me-1"></i>
                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}