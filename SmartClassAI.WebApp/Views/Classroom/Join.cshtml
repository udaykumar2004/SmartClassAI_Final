@{
    ViewData["Title"] = "Join Class";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="sidebar-brand-icon d-inline-flex mb-3" style="width:56px;height:56px;border-radius:16px">
                <i class="fa-solid fa-link"></i>
            </div>
            <h2 class="fw-bold">Join a classroom</h2>
            <p class="text-muted">Enter the 6-character code from your teacher</p>
        </div>

        <form asp-action="Join" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="form-label fw-semibold">Join code</label>
                <input type="text" name="joinCode" value="@TempData["JoinCode"]"
                       class="form-control form-control-lg text-center fw-bold"
                       placeholder="ABC123" maxlength="8" required
                       style="letter-spacing:0.25em;text-transform:uppercase" />
            </div>
            <button type="submit" class="btn btn-sc-primary w-100 btn-lg mb-3">
                <i class="fa-solid fa-right-to-bracket me-2"></i>Join classroom
            </button>
            <a asp-action="Index" class="btn btn-light w-100 rounded-3">Back to classes</a>
        </form>
    </div>
</div>
