@model SmartClassAI.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    ViewData["PageSubtitle"] = "Manage your account and profile photo";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
}

<partial name="_PageHeader" />

<div class="sc-card" style="max-width:600px">
    <div class="card-body">
        <h4 class="mb-4">My Profile</h4>
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Full name</label>
                <input name="fullName" class="form-control" value="@Model.FullName" required />
            </div>
            <motion class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" disabled />
            </motion>
            <div class="mb-3">
                <label class="form-label">Profile image</label>
                <input type="file" name="profileImage" class="form-control" accept="image/*" />
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" class="mt-2 rounded" style="max-height:80px" alt="Profile" />
                }
            </div>
            <p>
                @foreach (var role in roles)
                {
                    <span class="badge bg-primary">@role</span>
                }
            </p>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>
</div>
