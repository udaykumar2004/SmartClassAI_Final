@{
    ViewData["Title"] = "Video Meeting";

    string roomId = ViewBag.RoomId;
    int classroomId = ViewBag.ClassroomId;
    string userName = ViewBag.UserName;


    bool canStartMeeting = ViewBag.CanStartMeeting ?? false;
    }
    <script src="https://meet.jit.si/external_api.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<div class="container-fluid p-0">

    <div class="row g-0">

        <!-- VIDEO -->

        <div class="col-lg-9">

            <div id="jitsi-container"
                 style="height:100vh;width:100%;">
            </div>

        </div>
        <div class="col-lg-3 bg-dark text-white d-flex flex-column"
             style="height:100vh;">

            <div class="p-3 border-bottom">

                <h4>Class Chat</h4>

            </div>

            <div id="messagesList"
                 class="flex-grow-1 p-3 overflow-auto">
            </div>
            <div class="p-3 border-top">

                <div class="d-flex gap-2">

                    <input type="text"
                           id="messageInput"
                           class="form-control"
                           placeholder="Type message..." />

                    <button id="sendButton"
                            class="btn btn-primary">

                        Send

                    </button>

                </div>
            </div>

        </div>

    </div>

</div>

<script>
    const domain = "meet.jit.si";

       const options = {
           roomName: "@roomId",
           width: "100%",
           height: "100%",
           parentNode: document.querySelector('#jitsi-container'),
           userInfo: {
               displayName: "@userName"
           }
       };

       const api = new JitsiMeetExternalAPI(
           domain,
           options
       );
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/classroomHub")
        .build();

    connection.start().then(function () {

        connection.invoke(
            "JoinClassroom",
            "@classroomId"
        );

    });
     connection.on(
        "ReceiveMessage",
        function (user, message, time) {

            const div = document.createElement("div");

            div.className =
                "mb-3 p-2 rounded bg-secondary";

            div.innerHTML = `
                <strong>${user}</strong>
                <small class="ms-2">${time}</small>
                <div>${message}</div>
            `;

            document
                .getElementById("messagesList")
                .appendChild(div);
        }
         );

    document
        .getElementById("sendButton")
        .addEventListener("click", function () {

            const message =
                document
                .getElementById("messageInput")
                .value;

            if (!message.trim())
                return;

            connection.invoke(
                "SendMessage",
@classroomId,
                "@userName",
                message
            );
            document
                .getElementById("messageInput")
                .value = "";
        });

</script>