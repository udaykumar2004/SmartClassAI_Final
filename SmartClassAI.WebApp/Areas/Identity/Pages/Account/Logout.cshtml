@page
@model LogoutModel

@{
    ViewData["Title"] = "Logout";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-5 text-center">

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <!-- ICON -->

                        <div class="mb-4">

                            <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center"
                                 style="width:90px; height:90px;">

                                <span style="font-size:40px;">🚪</span>

                            </div>

                        </div>

                        <!-- TITLE -->

                        <h2 class="fw-bold text-dark mb-3">
                            Logout Confirmation
                        </h2>

                        <p class="text-muted mb-4">
                            Are you sure you want to logout from
                            <span class="fw-semibold text-primary">
                                SmartClass AI
                            </span>?
                        </p>

                        <!-- LOGOUT BUTTON -->

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger btn-lg px-5 rounded-3 shadow-sm">

                                Logout

                            </button>

                        </form>

                        <!-- CANCEL -->

                        <div class="mt-4">

                            <a href="/"
                               class="text-decoration-none fw-semibold">

                                ← Back to Home

                            </a>

                        </div>
                    }
                    else
                    {
                        <!-- SUCCESS -->

                        <div class="mb-4">

                            <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center"
                                 style="width:90px; height:90px;">

                                <span style="font-size:40px;">✅</span>

                            </div>

                        </div>

                        <h2 class="fw-bold text-success mb-3">
                            Logged Out Successfully
                        </h2>

                        <p class="text-muted mb-4">
                            You have successfully logged out from
                            SmartClass AI.
                        </p>

                        <a href="/"
                           class="btn btn-primary btn-lg rounded-3 px-4">

                            Go to Homepage

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>